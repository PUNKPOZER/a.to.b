# All optional. Copy to .env and export, or pass to docker run -e.
SELECTOR_CORS_ORIGINS=          # extra allowed frontend origins, comma separated (localhost + https://punkpozer.github.io are built in)
SELECTOR_MAX_UPLOAD_MB=200
SELECTOR_MAX_ANALYZE_SECONDS=900  # only the first 15 min of a track are analysed
SELECTOR_WORKERS=1                # CPU-bound: keep 1 unless you have spare cores
SELECTOR_CACHE_DIR=               # default: system temp dir
SELECTOR_MODEL_DIR=               # where the Discogs-EffNet model is downloaded (default backend/models, ~18 MB, sha256-verified)
SELECTOR_MAX_EMBED_SECONDS=900    # embed at most the first 15 min of a track
SELECTOR_EXTERNAL_DISCOVERY_KEY=  # reserved for a future external discovery provider (server-side only; never in the frontend)
