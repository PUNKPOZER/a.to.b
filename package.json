{
  "name": "noesis",
  "version": "0.4.1",
  "private": true,
  "description": "NOESIS — DJ tools for deeper selection (by punk pozer)",
  "scripts": {
    "vendor": "node scripts/vendor-essentia.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "setup": "bash scripts/setup.sh",
    "dev": "node scripts/dev.mjs",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:mac": "node scripts/prepare-desktop.mjs && electron-builder --mac --publish never",
    "dist:win": "node scripts/prepare-desktop.mjs && electron-builder --win --publish never",
    "icon": "electron desktop/make-icon.js",
    "prepare:desktop": "node scripts/prepare-desktop.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "essentia.js": "0.1.3",
    "ffmpeg-static": "^5.3.0"
  },
  "main": "desktop/main.js",
  "author": "punk pozer",
  "homepage": "https://github.com/PUNKPOZER/noesis",
  "build": {
    "appId": "com.punkpozer.noesis",
    "productName": "NOESIS",
    "copyright": "developed by punk pozer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/*.js",
      "desktop/*.html",
      "index.html",
      "app/**",
      "audio/**",
      "engine/**",
      "ui/**",
      "assets/**",
      "vendor/**",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "!**/.DS_Store"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "build/resources",
        "to": "resources"
      }
    ],
    "asarUnpack": []
  }
}